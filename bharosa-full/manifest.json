{
  "manifest_version": 3,
  "name": "Bharosa",
  "version": "1.0.0",
  "description": "Redact private details before you share a document. Check whether a website is genuine. Runs on your device, nothing to install.",
  "action": { "default_popup": "popup.html", "default_title": "Bharosa", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://rdap.org/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
