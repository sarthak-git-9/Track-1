# Configure these after loading the unpacked extension and copying its ID from chrome://extensions.
# Example: chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
BHAROSA_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID

# Optional. Leave unset to generate a fresh random token each time the backend starts.
# Never commit a real token.
# BHAROSA_API_TOKEN=replace-with-a-long-random-secret

# Optional local Ollama endpoint and exact installed model tag. Must stay on localhost.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=your-installed-model-tag
